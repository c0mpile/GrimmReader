#!/usr/bin/env python3
"""Generates LucideIcons.kt (Compose ImageVectors) from Lucide SVG sources (ISC licence).

usage: scripts/gen-lucide-icons <dir with lucide *.svg> <output .kt file>
Inputs are trusted Lucide sources fetched by a developer (stdlib expat does not resolve external entities).
Supports the elements Lucide uses: path, circle, rect (with rx), line, polyline, polygon, ellipse.
"""
import pathlib
import re
import sys
import xml.etree.ElementTree as ET


def f(v):
    return float(v) if v is not None else 0.0


def to_path(el):
    tag = el.tag.split('}')[-1]
    a = el.attrib
    if tag == 'path':
        return a['d']
    if tag in ('circle', 'ellipse'):
        cx, cy = f(a.get('cx')), f(a.get('cy'))
        rx = f(a.get('r', a.get('rx')))
        ry = f(a.get('r', a.get('ry')))
        return f"M{cx - rx} {cy}a{rx} {ry} 0 1 0 {2 * rx} 0a{rx} {ry} 0 1 0 {-2 * rx} 0z"
    if tag == 'rect':
        x, y, w, h = f(a.get('x')), f(a.get('y')), f(a['width']), f(a['height'])
        rx = f(a.get('rx', a.get('ry')))
        ry = f(a.get('ry', a.get('rx')))
        if rx == 0:
            return f"M{x} {y}h{w}v{h}h{-w}z"
        return (f"M{x + rx} {y}h{w - 2 * rx}a{rx} {ry} 0 0 1 {rx} {ry}v{h - 2 * ry}a{rx} {ry} 0 0 1 {-rx} {ry}"
                f"h{-(w - 2 * rx)}a{rx} {ry} 0 0 1 {-rx} {-ry}v{-(h - 2 * ry)}a{rx} {ry} 0 0 1 {rx} {-ry}z")
    if tag == 'line':
        return f"M{a['x1']} {a['y1']}L{a['x2']} {a['y2']}"
    if tag in ('polyline', 'polygon'):
        pts = re.split(r'[\s,]+', a['points'].strip())
        pairs = [f"{pts[i]} {pts[i + 1]}" for i in range(0, len(pts), 2)]
        return 'M' + 'L'.join(pairs) + ('z' if tag == 'polygon' else '')
    raise ValueError(f"unsupported element {tag}")


def camel(name):
    return ''.join(p.capitalize() for p in name.split('-'))


def main():
    src, out = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
    icons = []
    for svg in sorted(src.glob('*.svg')):
        root = ET.parse(svg).getroot()
        paths = [to_path(el) for el in root if el.tag.split('}')[-1] != 'title']
        body = '\n'.join(f'            stroke("{p}")' for p in paths)
        icons.append(f"""    val {camel(svg.stem)}: ImageVector by lazy {{
        lucide("{svg.stem}") {{
{body}
        }}
    }}""")
    out.write_text(f"""// Generated by scripts/gen-lucide-icons from Lucide (https://lucide.dev, ISC licence). Do not edit.
package com.c0mpile.grimmreader.core.designsystem.icon

import androidx.compose.ui.graphics.vector.ImageVector

@Suppress("MaxLineLength")
object LucideIcons {{
{chr(10).join(icons)}
}}
""")


main()
