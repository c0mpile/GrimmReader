#!/usr/bin/env bash
# Builds the GrimmReader APK (debug by default) and prints where it is.
# Debug builds are signed by Gradle with the debug key; release builds are signed afterwards with the
# private release key via scripts/sign-release.
#   -r  release build instead of debug
#   -i  install on the connected device(s) afterwards
set -euo pipefail
# Resolve symlinks (e.g. ~/.local/bin/grbuild) so the repo is found from anywhere.
cd "$(dirname "$(readlink -f "$0")")/.."

variant=debug
install=false
while getopts "ri" opt; do
    case "$opt" in
        r) variant=release ;;
        i) install=true ;;
        *) echo "usage: grbuild [-r] [-i]" >&2; exit 2 ;;
    esac
done

task="assemble${variant^}"
[[ $install == true && $variant == debug ]] && task="installDebug"

# Status of gradlew itself, not of the output filter (grep finds nothing on a quiet success).
status=0
./gradlew "$task" -q --console=plain 2>&1 | grep -E 'FAILED|error:|^e: |BUILD|Installed|No such file' || status=${PIPESTATUS[0]}
if [[ $status -ne 0 ]]; then
    echo "grbuild: $task failed" >&2
    exit "$status"
fi
if [[ $variant == release ]]; then
    # Prints the signed APK path; installs it when -i was given.
    if [[ $install == true ]]; then scripts/sign-release -i; else scripts/sign-release; fi
else
    ls -lh app/build/outputs/apk/debug/*.apk
fi
