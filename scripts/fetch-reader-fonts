#!/usr/bin/env python3
"""Fetches the bundled reader fonts from pinned upstream sources into reader/ebook assets and licenses/.

usage: scripts/fetch-reader-fonts            (needs network and fontTools: `python3 -m pip install fonttools`)

Fonts with a Reserved Font Name (Source Sans, Lato, Merriweather) are copied unmodified: the OFL does not let a
modified copy keep that name. The others are subset to Latin, Greek and Cyrillic without hinting, and the width
axis is pinned to 100 where a font has one. GitHub sources are pinned by commit; the Charter zip by sha256. Georgia is proprietary; Gelasio (OFL, metric-compatible) is bundled in its place.
"""
import hashlib
import io
import pathlib
import sys
import urllib.request
import zipfile

try:
    from fontTools import subset
    from fontTools.ttLib import TTFont
    from fontTools.varLib import instancer
except ImportError:
    sys.exit('fontTools is missing: python3 -m pip install fonttools')

ROOT = pathlib.Path(__file__).resolve().parent.parent
ASSETS = ROOT / 'reader/ebook/src/main/assets/fonts'
LICENSES = ROOT / 'licenses'

GF = 'https://raw.githubusercontent.com/google/fonts/5e8a3ba899557829a76cfdac30fa512bda91d7ca/ofl'
MW = 'https://raw.githubusercontent.com/SorkinType/Merriweather/4481226b336843648b5b2ee64f75737f262ded15'
CHARTER_ZIP = 'https://practicaltypography.com/fonts/Charter%20210112.zip'
CHARTER_SHA = 'b40297f1a615f94594bdad0995848eb2223fb53ccb4ea197cabf24439bd811c9'
CHARTER_DIR = 'Charter 210112/TTF format (best for Windows)/Charter/'

KEEP, SUBSET = 'keep', 'subset'

# (asset file, source url, mode); the licence of each family follows in LICENCES.
FONTS = [
    ('source-sans-3.ttf', f'{GF}/sourcesans3/SourceSans3%5Bwght%5D.ttf', KEEP),
    ('source-sans-3-italic.ttf', f'{GF}/sourcesans3/SourceSans3-Italic%5Bwght%5D.ttf', KEEP),
    ('roboto.ttf', f'{GF}/roboto/Roboto%5Bwdth,wght%5D.ttf', SUBSET),
    ('roboto-italic.ttf', f'{GF}/roboto/Roboto-Italic%5Bwdth,wght%5D.ttf', SUBSET),
    ('lato-regular.ttf', f'{GF}/lato/Lato-Regular.ttf', KEEP),
    ('lato-italic.ttf', f'{GF}/lato/Lato-Italic.ttf', KEEP),
    ('lato-bold.ttf', f'{GF}/lato/Lato-Bold.ttf', KEEP),
    ('lato-bold-italic.ttf', f'{GF}/lato/Lato-BoldItalic.ttf', KEEP),
    ('open-sans.ttf', f'{GF}/opensans/OpenSans%5Bwdth,wght%5D.ttf', SUBSET),
    ('open-sans-italic.ttf', f'{GF}/opensans/OpenSans-Italic%5Bwdth,wght%5D.ttf', SUBSET),
    ('noto-sans.ttf', f'{GF}/notosans/NotoSans%5Bwdth,wght%5D.ttf', SUBSET),
    ('noto-sans-italic.ttf', f'{GF}/notosans/NotoSans-Italic%5Bwdth,wght%5D.ttf', SUBSET),
    ('gelasio.ttf', f'{GF}/gelasio/Gelasio%5Bwght%5D.ttf', SUBSET),
    ('gelasio-italic.ttf', f'{GF}/gelasio/Gelasio-Italic%5Bwght%5D.ttf', SUBSET),
    ('merriweather-regular.ttf', f'{MW}/fonts/ttf/Merriweather-Regular.ttf', KEEP),
    ('merriweather-italic.ttf', f'{MW}/fonts/ttf/Merriweather-Italic.ttf', KEEP),
    ('merriweather-bold.ttf', f'{MW}/fonts/ttf/Merriweather-Bold.ttf', KEEP),
    ('merriweather-bold-italic.ttf', f'{MW}/fonts/ttf/Merriweather-BoldItalic.ttf', KEEP),
    ('crimson-text-regular.ttf', f'{GF}/crimsontext/CrimsonText-Regular.ttf', SUBSET),
    ('crimson-text-italic.ttf', f'{GF}/crimsontext/CrimsonText-Italic.ttf', SUBSET),
    ('crimson-text-bold.ttf', f'{GF}/crimsontext/CrimsonText-Bold.ttf', SUBSET),
    ('crimson-text-bold-italic.ttf', f'{GF}/crimsontext/CrimsonText-BoldItalic.ttf', SUBSET),
    ('eb-garamond.ttf', f'{GF}/ebgaramond/EBGaramond%5Bwght%5D.ttf', SUBSET),
    ('eb-garamond-italic.ttf', f'{GF}/ebgaramond/EBGaramond-Italic%5Bwght%5D.ttf', SUBSET),
    ('source-serif-4.ttf', f'{GF}/sourceserif4/SourceSerif4%5Bopsz,wght%5D.ttf', SUBSET),
    ('source-serif-4-italic.ttf', f'{GF}/sourceserif4/SourceSerif4-Italic%5Bopsz,wght%5D.ttf', SUBSET),
    ('atkinson-hyperlegible-regular.ttf', f'{GF}/atkinsonhyperlegible/AtkinsonHyperlegible-Regular.ttf', SUBSET),
    ('atkinson-hyperlegible-italic.ttf', f'{GF}/atkinsonhyperlegible/AtkinsonHyperlegible-Italic.ttf', SUBSET),
    ('atkinson-hyperlegible-bold.ttf', f'{GF}/atkinsonhyperlegible/AtkinsonHyperlegible-Bold.ttf', SUBSET),
    ('atkinson-hyperlegible-bold-italic.ttf', f'{GF}/atkinsonhyperlegible/AtkinsonHyperlegible-BoldItalic.ttf', SUBSET),
    ('literata.ttf', f'{GF}/literata/Literata%5Bopsz,wght%5D.ttf', SUBSET),
    ('literata-italic.ttf', f'{GF}/literata/Literata-Italic%5Bopsz,wght%5D.ttf', SUBSET),
]

LICENCES = [
    ('SourceSans3-OFL.txt', f'{GF}/sourcesans3/OFL.txt'),
    ('Roboto-OFL.txt', f'{GF}/roboto/OFL.txt'),
    ('Lato-OFL.txt', f'{GF}/lato/OFL.txt'),
    ('OpenSans-OFL.txt', f'{GF}/opensans/OFL.txt'),
    ('NotoSans-OFL.txt', f'{GF}/notosans/OFL.txt'),
    ('Gelasio-OFL.txt', f'{GF}/gelasio/OFL.txt'),
    ('Merriweather-OFL.txt', f'{MW}/OFL.txt'),
    ('CrimsonText-OFL.txt', f'{GF}/crimsontext/OFL.txt'),
    ('EBGaramond-OFL.txt', f'{GF}/ebgaramond/OFL.txt'),
    ('SourceSerif4-OFL.txt', f'{GF}/sourceserif4/OFL.txt'),
    ('AtkinsonHyperlegible-OFL.txt', f'{GF}/atkinsonhyperlegible/OFL.txt'),
    ('Literata-OFL.txt', f'{GF}/literata/OFL.txt'),
]

CHARTER = [
    ('charter-regular.ttf', 'Charter Regular.ttf'),
    ('charter-italic.ttf', 'Charter Italic.ttf'),
    ('charter-bold.ttf', 'Charter Bold.ttf'),
    ('charter-bold-italic.ttf', 'Charter Bold Italic.ttf'),
]

# Latin (with Vietnamese), Greek, Cyrillic, punctuation, currency, letterlike symbols, arrows, ligatures.
UNICODES = (
    'U+0000-024F,U+0259,U+02B0-036F,U+0370-03FF,U+0400-052F,U+1E00-1EFF,U+2000-206F,U+20A0-20CF,'
    'U+2100-214F,U+2150-218F,U+2190-21FF,U+2212,U+2215,U+2C60-2C7F,U+A720-A7FF,U+FB00-FB06,U+FEFF,U+FFFD'
)


def fetch(url):
    with urllib.request.urlopen(url, timeout=60) as r:
        return r.read()


def shrink(data, dst):
    font = TTFont(io.BytesIO(data))
    if 'fvar' in font and any(a.axisTag == 'wdth' for a in font['fvar'].axes):
        buf = io.BytesIO()
        instancer.instantiateVariableFont(font, {'wdth': 100}).save(buf)
        # Reload: subsetting the in-memory instance trips over its lazily loaded glyph variations.
        font = TTFont(io.BytesIO(buf.getvalue()))
    options = subset.Options()
    options.layout_features = ['*']
    options.name_IDs = ['*']
    options.name_languages = ['*']
    options.hinting = False
    options.notdef_outline = True
    options.drop_tables += ['DSIG']
    subsetter = subset.Subsetter(options)
    subsetter.populate(unicodes=subset.parse_unicodes(UNICODES))
    subsetter.subset(font)
    font.save(dst)


def describe(path):
    font = TTFont(path)
    axes = ' '.join(f'{a.axisTag}={a.minValue:g}..{a.maxValue:g}' for a in font['fvar'].axes) if 'fvar' in font else ''
    weight = font['OS/2'].usWeightClass
    return f'{path.name:40} {path.stat().st_size // 1024:6} KiB  weight {weight}  {axes}'


def main():
    ASSETS.mkdir(parents=True, exist_ok=True)
    for old in ASSETS.glob('*.ttf'):
        old.unlink()
    for name, url, mode in FONTS:
        data = fetch(url)
        dst = ASSETS / name
        if mode == KEEP:
            dst.write_bytes(data)
        else:
            shrink(data, dst)
        print(describe(dst))
    charter = fetch(CHARTER_ZIP)
    if hashlib.sha256(charter).hexdigest() != CHARTER_SHA:
        sys.exit('Charter zip checksum mismatch')
    with zipfile.ZipFile(io.BytesIO(charter)) as z:
        for name, member in CHARTER:
            (ASSETS / name).write_bytes(z.read(CHARTER_DIR + member))
            print(describe(ASSETS / name))
        (LICENSES / 'Charter-Bitstream.txt').write_bytes(z.read('Charter 210112/Charter license.txt'))
    for name, url in LICENCES:
        (LICENSES / name).write_bytes(fetch(url))
    total = sum(p.stat().st_size for p in ASSETS.glob('*.ttf'))
    print(f'total {total // 1024} KiB')


if __name__ == '__main__':
    main()
