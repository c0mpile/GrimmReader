#!/usr/bin/env bash
# Signs the release APK so it can be installed (optionally builds it first, optionally installs it).
#   -b  build the release APK first (assembleRelease)
#   -i  install the signed APK on the connected device(s) afterwards
# The signing key is private and never tracked. Preferred source is the system keyring (Secret
# Service), service GRIMMREADER_KEYRING_SERVICE (default grimmreader-signing), with one entry per
# field (username=FIELD), as filled by bw-keyring-sync from a Bitwarden item's custom fields:
#   KEYSTORE_B64_1..N the keystore file as base64, split in order into chunks of <= 2500 characters
#                     (a Bitwarden field holds at most 5000 encrypted characters); a single
#                     KEYSTORE_B64 holding the whole thing also works
#   KEY_ALIAS         key alias
#   KEYSTORE_PASSWORD store and key password
# The keystore is written to a private temp file on tmpfs for the signing only, then removed.
# Fallback while migrating: GRIMMREADER_KEYSTORE_PROPERTIES, default .local/signing/keystore.properties
# (storeFile=, alias=, password=). Passwords are never printed.
# Output: .local/apk/GrimmReader-<version>-<commit>-release.apk
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."

build=false
install=false
while getopts "bi" opt; do
    case "$opt" in
        b) build=true ;;
        i) install=true ;;
        *) echo "usage: sign-release [-b] [-i]" >&2; exit 2 ;;
    esac
done

service="${GRIMMREADER_KEYRING_SERVICE:-grimmreader-signing}"
secret() { timeout 10 secret-tool lookup service "$service" username "$1" 2>/dev/null || true; }

aligned=
tmp_store=
trap 'rm -f "$aligned" "$tmp_store"' EXIT

store_b64=$(secret KEYSTORE_B64)
for ((i = 1; ; i++)); do
    chunk=$(secret "KEYSTORE_B64_$i")
    [[ -n $chunk ]] || break
    store_b64+=$chunk
done
if [[ -n $store_b64 ]]; then
    alias_name=$(secret KEY_ALIAS)
    KS_PW=$(secret KEYSTORE_PASSWORD)
    [[ -n $alias_name && -n $KS_PW ]] || { echo "sign-release: keyring service $service lacks KEY_ALIAS or KEYSTORE_PASSWORD" >&2; exit 1; }
    umask 077
    tmp_store=$(mktemp -p "${XDG_RUNTIME_DIR:-/dev/shm}" --suffix=.jks)
    base64 -d <<<"$store_b64" > "$tmp_store" || { echo "sign-release: the keystore entries are not valid base64" >&2; exit 1; }
    store=$tmp_store
else
    props="${GRIMMREADER_KEYSTORE_PROPERTIES:-.local/signing/keystore.properties}"
    [[ -f $props ]] || { echo "sign-release: no signing key in keyring service $service and $props not found" >&2; exit 1; }
    echo "sign-release: keyring has no key; falling back to $props" >&2
    prop() { grep -m1 "^$1=" "$props" | cut -d= -f2-; }
    store=$(prop storeFile)
    alias_name=$(prop alias)
    KS_PW=$(prop password)
    [[ -f $store ]] || { echo "sign-release: keystore $store not found" >&2; exit 1; }
fi
export KS_PW

[[ $build == true ]] && ./gradlew assembleRelease -q --console=plain > /dev/null

unsigned=$(ls app/build/outputs/apk/release/*-unsigned.apk 2>/dev/null | head -1 || true)
[[ -n $unsigned ]] || { echo "sign-release: no unsigned release APK; run with -b" >&2; exit 1; }

version=$(grep -m1 'versionName' app/build.gradle.kts | sed -E 's/.*"([^"]+)".*/\1/' || true)
out=".local/apk/GrimmReader-${version:-dev}-$(git rev-parse --short HEAD)-release.apk"
mkdir -p .local/apk
aligned=$(mktemp --suffix=.apk)
rm -f "$aligned" "$out"
zipalign -P 16 -f 4 "$unsigned" "$aligned"
apksigner sign --ks "$store" --ks-key-alias "$alias_name" \
    --ks-pass env:KS_PW --key-pass env:KS_PW --out "$out" "$aligned"
apksigner verify "$out" > /dev/null
rm -f "$out.idsig"
ls -lh "$out"

if [[ $install == true ]]; then
    adb install -r "$out"
fi
